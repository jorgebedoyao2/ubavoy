rules_version = '2';

// ============================================================================
// UbaVoy - Reglas de Seguridad de Firestore
// ============================================================================
// Modelo de identidad: TODA persona (cliente, domiciliario, admin) entra con
// Firebase Auth. El documento users/{uid} usa el uid de Auth como ID.
//
// QUIÉN PUEDE TRABAJAR: la llave de acceso de los domiciliarios es la
// colección 'autorizados', donde el administrador habilita el correo de quien
// pagó su paquete. Ese es el control real; el campo is_approved del perfil
// quedó solo como dato informativo del panel.
//
// Campos sensibles y quién los puede tocar:
//   role         -> solo admin (define si es client / driver / admin)
//   balance      -> solo admin (recargas). El domiciliario SOLO puede
//                   descontarse exactamente el costo de una carrera.
//   autorizados  -> solo admin (habilita o corta el acceso al trabajo)
//
// Nota sobre el plan Spark (gratis): no hay Cloud Functions, así que toda la
// validación de dinero vive aquí. Estas reglas corren en los servidores de
// Google y NO se pueden saltar desde el navegador, a diferencia del PIN que
// tenía antes el panel de admin.
//
// PRIMER ADMINISTRADOR: las reglas impiden que alguien se autoproclame admin,
// lo que dejaría a la plataforma sin ningún administrador posible. Se resuelve
// reconociendo el correo del dueño (ver esDuenoDeLaPlataforma). No hay que
// marcar nada a mano en la consola.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Constantes del negocio ----------
    function costoCarrera()    { return 1000; }  // comisión por carrera
    function preciosValidos()  { return [5000, 7000]; }  // urbano / perímetro

    // ---------- Helpers de identidad ----------
    function estaLogueado() {
      return request.auth != null;
    }

    function datosDe(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function existeMiPerfil() {
      return estaLogueado() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function miRol() {
      return datosDe(request.auth.uid).role;
    }

    // Correo de la sesión, siempre en minúsculas para que las comparaciones
    // no dependan de cómo lo escribió la persona.
    function miCorreo() {
      return request.auth.token.get('email', '').lower();
    }

    // Correo del dueño de la plataforma. Se reconoce como administrador
    // aunque su documento en 'users' no exista, lo que evita el problema del
    // huevo y la gallina: las reglas impiden autoproclamarse admin, así que
    // sin esto nadie podría serlo la primera vez.
    //
    // NOTA: no se exige email_verified. En el proyecto el ÚNICO proveedor
    // habilitado es Google, que entrega el correo ya verificado; exigir ese
    // campo hacía que el panel fallara con permission-denied si el token no
    // lo traía. Si algún día se habilita ingreso con contraseña, hay que
    // volver a exigirlo.
    function esDuenoDeLaPlataforma() {
      return estaLogueado() && miCorreo() == 'devsites02@gmail.com';
    }

    function esAdmin() {
      return esDuenoDeLaPlataforma() || (existeMiPerfil() && miRol() == 'admin');
    }

    // ---------- Habilitación de domiciliarios por correo ----------
    // El administrador habilita el correo de quien pagó su paquete de
    // domicilios en la colección 'autorizados'. Mientras ese documento exista
    // y esté activo, la persona puede trabajar; al desactivarlo pierde el
    // acceso de inmediato, sin importar lo que diga su perfil.
    function correoHabilitado(correo) {
      return correo != ''
             && exists(/databases/$(database)/documents/autorizados/$(correo))
             && get(/databases/$(database)/documents/autorizados/$(correo)).data.get('activo', false) == true;
    }

    function esDomiciliarioAprobado() {
      return existeMiPerfil()
             && miRol() == 'driver'
             && correoHabilitado(miCorreo());
    }

    // Devuelve true si la escritura SOLO toca los campos permitidos.
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Nota: affectedKeys() devuelve un Set, y el operador "in" no aplica a Sets
    // en las reglas de Firestore (produce error de evaluación). Se usa hasAny().
    function noCambia(campo) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([campo]);
    }

    // =========================================================================
    // users/{uid}  - perfiles de clientes, domiciliarios y administradores
    // =========================================================================
    match /users/{uid} {

      // Cada quien ve su propio perfil. El admin ve todos.
      allow get: if estaLogueado() && (request.auth.uid == uid || esAdmin());

      // Listar usuarios es exclusivo del panel de admin.
      allow list: if esAdmin();

      // Al registrarse, la persona crea SU propio documento y arranca
      // sin saldo, sin aprobar y sin poder elegir ser admin.
      allow create: if estaLogueado()
                    && request.auth.uid == uid
                    && request.resource.data.role in ['client', 'driver']
                    && request.resource.data.get('balance', 0) == 0
                    && request.resource.data.get('is_approved', false) == false;

      // Edición normal por el propio dueño: puede cambiar sus datos de
      // contacto, pero NUNCA su rol, su aprobación ni su saldo.
      function editaSuPerfil(uidObjetivo) {
        return estaLogueado()
               && resource != null
               && request.auth.uid == uidObjetivo
               && noCambia('role')
               && noCambia('is_approved')
               && noCambia('balance');
      }

      // Excepción controlada: el domiciliario puede descontarse el costo de
      // una carrera, y SOLO eso. No puede subirse el saldo ni ponerlo en
      // cualquier número: la resta tiene que ser exacta y tiene que alcanzarle.
      // Esto es lo que hoy permite "saldo infinito" borrando el navegador.
      function esCobroDeCarrera(uidObjetivo) {
        return estaLogueado()
               && resource != null
               && request.auth.uid == uidObjetivo
               && soloCambia(['balance'])
               && resource.data.get('balance', 0) >= costoCarrera()
               && request.resource.data.balance == resource.data.get('balance', 0) - costoCarrera();
      }

      allow update: if editaSuPerfil(uid)
                    || esCobroDeCarrera(uid)
                    || esAdmin();

      // Nadie borra usuarios desde las apps.
      allow delete: if false;
    }

    // =========================================================================
    // orders/{orderId}  - pedidos / mandados
    // =========================================================================
    match /orders/{orderId} {

      function esMiPedido() {
        return estaLogueado()
               && resource != null
               && resource.data.get('client_uid', '') == request.auth.uid;
      }

      function soyElAsignado() {
        return estaLogueado()
               && resource != null
               && resource.data.get('assigned_driver_id', '') == request.auth.uid;
      }

      // El cliente ve los suyos; el domiciliario aprobado ve la bolsa de
      // trabajo; el admin lo ve todo. Un visitante anónimo NO ve nada:
      // esto es lo que hoy deja expuestos los teléfonos de tus clientes.
      allow read: if esMiPedido() || esDomiciliarioAprobado() || esAdmin();

      // Crear pedido: solo un usuario logueado, a su propio nombre, con
      // precio de la lista oficial, coordenadas reales y PIN de 4 dígitos.
      allow create: if estaLogueado()
                    && request.resource.data.client_uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.estimated_price in preciosValidos()
                    && request.resource.data.delivery_coords.lat is number
                    && request.resource.data.delivery_coords.lng is number
                    && request.resource.data.delivery_pin is string
                    && request.resource.data.delivery_pin.size() == 4
                    && request.resource.data.get('assigned_driver_id', null) == null;

      // --- Tomar una carrera ---
      // Solo un domiciliario aprobado, solo si el pedido sigue 'pending', y
      // solo asignándose a sí mismo. Esto es lo que impide que dos
      // domiciliarios se queden con el mismo pedido: el segundo intento
      // encuentra status != 'pending' y el servidor lo rechaza.
      function tomaLaCarrera() {
        return esDomiciliarioAprobado()
               && resource != null
               && resource.data.status == 'pending'
               && request.resource.data.status == 'assigned'
               && request.resource.data.assigned_driver_id == request.auth.uid
               && request.resource.data.client_uid == resource.data.client_uid
               && request.resource.data.estimated_price == resource.data.estimated_price;
      }

      // El domiciliario asignado mueve el pedido por sus estados, comparte su
      // ubicación en vivo y puede avisarle novedades al cliente. No puede
      // tocar el precio, el PIN ni el dueño del pedido.
      function avanzaSuCarrera() {
        return soyElAsignado()
               && soloCambia([
                    'status', 'updated_at', 'delivered_at', 'picked_up_at',
                    'completed_at', 'driver_coords', 'driver_coords_at',
                    'driver_novedad', 'driver_novedad_at'
                  ])
               && (
                    // O bien no cambia el estado (solo ubicación / novedad),
                    !('status' in request.resource.data.diff(resource.data).affectedKeys())
                    // o lo mueve a un estado válido de avance.
                    || request.resource.data.status in ['picked_up', 'in_transit', 'delivered', 'completed']
                  );
      }

      // El cliente puede cancelar mientras nadie la haya tomado.
      function cancelaSuPedido() {
        return esMiPedido()
               && resource.data.get('status', '') == 'pending'
               && request.resource.data.status == 'cancelled'
               && soloCambia(['status', 'cancelled_at']);
      }

      allow update: if tomaLaCarrera() || avanzaSuCarrera() || cancelaSuPedido() || esAdmin();

      // Los pedidos son el historial contable del negocio, así que ni el
      // cliente ni el domiciliario pueden borrarlos. El administrador sí,
      // porque necesita poder limpiar los pedidos de prueba de la etapa de
      // pruebas; para el día a día lo correcto es cancelarlos, no borrarlos.
      allow delete: if esAdmin();
    }

    // =========================================================================
    // recharges/{rechargeId}  - solicitudes de recarga de saldo (Nequi)
    // =========================================================================
    match /recharges/{rechargeId} {

      function esMiRecarga() {
        return estaLogueado()
               && resource != null
               && resource.data.get('driver_id', '') == request.auth.uid;
      }

      allow get:  if esMiRecarga() || esAdmin();
      allow list: if esAdmin();

      // El domiciliario solicita su recarga, siempre en estado 'pending'.
      // No puede crearla ya aprobada ni a nombre de otro.
      allow create: if estaLogueado()
                    && request.resource.data.driver_id == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0;

      // Aprobar o rechazar una recarga es exclusivo del admin.
      // (El saldo se acredita con increment() en la misma transacción.)
      allow update, delete: if esAdmin();
    }

    // =========================================================================
    // chats/{pedidoId}  - chat interno y efímero de una entrega
    // =========================================================================
    // Existe SOLO mientras dura la entrega. El documento padre guarda quiénes
    // son los dos participantes (denormalizado desde el pedido) para que las
    // reglas de cada mensaje resuelvan con UNA sola lectura, en vez de ir al
    // pedido en cada mensaje.
    //
    // Nadie más entra: ni otro domiciliario, ni otro cliente, ni un visitante.
    // El administrador tampoco lee las conversaciones: puede ver que el chat
    // existe, pero no su contenido. Es una decisión deliberada de privacidad.
    match /chats/{pedidoId} {

      function soyParticipante() {
        return estaLogueado()
               && resource != null
               && (resource.data.get('cliente_uid', '') == request.auth.uid
                   || resource.data.get('domiciliario_uid', '') == request.auth.uid);
      }

      // El pedido es la fuente de verdad de quién puede hablar con quién.
      function pedidoDelChat() {
        return get(/databases/$(database)/documents/orders/$(pedidoId)).data;
      }

      allow get: if soyParticipante();
      allow list: if false;   // nadie navega la lista de chats ajenos

      // Se crea al aceptar la carrera. Los participantes deben coincidir
      // EXACTAMENTE con los del pedido: así nadie abre un chat con un
      // cliente que no le corresponde.
      allow create: if estaLogueado()
                    && request.resource.data.cliente_uid == pedidoDelChat().client_uid
                    && request.resource.data.domiciliario_uid == pedidoDelChat().get('assigned_driver_id', '')
                    && request.auth.uid == request.resource.data.domiciliario_uid;

      // Solo se marca el cierre; los participantes no cambian nunca.
      allow update: if soyParticipante()
                    && soloCambia(['cerrado_en', 'expira_en'])
                    && request.resource.data.cliente_uid == resource.data.cliente_uid
                    && request.resource.data.domiciliario_uid == resource.data.domiciliario_uid;

      allow delete: if esAdmin();

      // ---------------------------------------------------------------------
      // mensajes/{mensajeId}
      // ---------------------------------------------------------------------
      match /mensajes/{mensajeId} {

        function participaEnEsteChat() {
          return estaLogueado()
                 && exists(/databases/$(database)/documents/chats/$(pedidoId))
                 && (get(/databases/$(database)/documents/chats/$(pedidoId)).data.cliente_uid == request.auth.uid
                     || get(/databases/$(database)/documents/chats/$(pedidoId)).data.domiciliario_uid == request.auth.uid);
        }

        function esElCliente() {
          return get(/databases/$(database)/documents/chats/$(pedidoId)).data.cliente_uid == request.auth.uid;
        }

        allow read: if participaEnEsteChat();

        // Reglas del mensaje. Se validan EN EL SERVIDOR, así que no se pueden
        // burlar modificando la app:
        //   - solo texto: no se acepta ningún campo de imagen ni de archivo,
        //     lo que evita costos de almacenamiento y ancho de banda.
        //   - el remitente declarado debe corresponder a quien escribe.
        //   - se bloquean secuencias de 7 o más dígitos seguidos, que es como
        //     se cuelan teléfonos y números de cuenta para sacar el negocio
        //     de la plataforma o presionar al cliente por fuera.
        //   - todo mensaje nace con fecha de expiración: nada queda para
        //     siempre en la base de datos.
        allow create: if participaEnEsteChat()
                      && request.resource.data.keys().hasOnly(
                           ['remitente', 'autor_uid', 'texto', 'creado_en', 'expira_en'])
                      && request.resource.data.autor_uid == request.auth.uid
                      && request.resource.data.remitente == (esElCliente() ? 'cliente' : 'domiciliario')
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 500
                      && !request.resource.data.texto.matches('.*[0-9]{7,}.*')
                      && request.resource.data.expira_en is timestamp;

        // Un mensaje enviado no se edita: el historial de una conversación no
        // se reescribe. Solo se le puede adelantar la expiración, que es lo
        // que hace la app al entregar el pedido.
        allow update: if participaEnEsteChat()
                      && soloCambia(['expira_en'])
                      && request.resource.data.expira_en is timestamp;

        // Cualquiera de los dos puede borrar la conversación al cerrarse, que
        // es el respaldo del borrado automático.
        allow delete: if participaEnEsteChat() || esAdmin();
      }
    }

    // =========================================================================
    // promociones/{codigo}  - códigos promocionales de un solo uso
    // =========================================================================
    // El ID del documento ES el código en mayúsculas (ej. UBAVOY10).
    //
    // Por qué el domiciliario NO se acredita el saldo solo: las reglas no
    // pueden validar en un solo paso "consume el código Y súbete el saldo",
    // así que dos intentos simultáneos podrían colarse. En vez de eso el
    // domiciliario solo CANJEA (crea una solicitud) y el administrador
    // aprueba, igual que con las recargas de Nequi.
    //
    // La garantía de un solo uso vive en la regla de update: una vez que el
    // código tiene 'usado_por', NINGUNA escritura puede volver a tomarlo, ni
    // siquiera la del administrador. Es irreversible por diseño.
    match /promociones/{codigo} {

      // Cualquiera con sesión puede consultar un código puntual para saber si
      // sirve, pero NO puede listarlos: hay que conocer el código exacto.
      allow get: if estaLogueado();
      allow list: if esAdmin();

      allow create: if esAdmin()
                    && request.resource.data.domicilios is int
                    && request.resource.data.domicilios > 0
                    && request.resource.data.domicilios <= 100
                    && request.resource.data.get('usado_por', null) == null;

      // Consumir el código: solo si sigue libre. Después de esto queda
      // quemado para siempre.
      function consumeElCodigo() {
        return esAdmin()
               && resource.data.get('usado_por', null) == null
               && request.resource.data.usado_por is string
               && request.resource.data.domicilios == resource.data.domicilios;
      }

      // Activar o desactivar un código que todavía nadie usó.
      function ajustaElCodigo() {
        return esAdmin()
               && resource.data.get('usado_por', null) == null
               && soloCambia(['activo']);
      }

      allow update: if consumeElCodigo() || ajustaElCodigo();
      allow delete: if esAdmin() && resource.data.get('usado_por', null) == null;
    }

    // =========================================================================
    // autorizados/{correo}  - lista blanca de domiciliarios habilitados
    // =========================================================================
    // El ID del documento ES el correo en minúsculas. Solo el administrador
    // escribe aquí: es el control de quién puede trabajar en la plataforma.
    match /autorizados/{correo} {

      // Cada persona puede consultar si SU propio correo está habilitado,
      // para que la app le explique por qué no puede entrar. El admin ve todo.
      allow get: if esAdmin() || (estaLogueado() && miCorreo() == correo);
      allow list: if esAdmin();

      // Habilitar, desactivar o borrar habilitaciones es exclusivo del admin.
      allow create, update, delete: if esAdmin();
    }

    // =========================================================================
    // Cierre por defecto: cualquier colección no declarada arriba queda
    // bloqueada. Si mañana agregamos una colección nueva, nace protegida.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
