{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "apps/**/*", "use": "@vercel/static" },
    { "src": "shared/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/driver", "dest": "/apps/driver/index.html" },
    { "src": "/driver/(.*)", "dest": "/apps/driver/$1" },
    { "src": "/admin", "dest": "/apps/admin/index.html" },
    { "src": "/admin/(.*)", "dest": "/apps/admin/$1" },
    { "src": "/shared/(.*)", "dest": "/shared/$1" },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/apps/client/$1" }
  ]
}
