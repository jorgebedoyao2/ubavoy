{
  "version": 2,
  "rewrites": [
    { "source": "/driver", "destination": "/apps/driver/index.html" },
    { "source": "/driver/(.*)", "destination": "/apps/driver/$1" },
    { "source": "/admin", "destination": "/apps/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/apps/admin/$1" },
    { "source": "/shared/(.*)", "destination": "/shared/$1" },
    { "source": "/(.*)", "destination": "/apps/client/$1" }
  ]
}
