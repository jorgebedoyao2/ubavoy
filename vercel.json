{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "apps/**/*", "use": "@vercel/static" },
    { "src": "shared/**/*", "use": "@vercel/static" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/shared/(.*)", "dest": "/shared/$1" },
    { "src": "/(icon-[^/]+\\.(?:svg|png))", "dest": "/public/$1" },
    { "src": "/(favicon\\.ico)", "dest": "/public/$1" },

    { "src": "/driver/?$", "status": 308, "headers": { "Location": "/apps/driver/" } },
    { "src": "/admin/?$", "status": 308, "headers": { "Location": "/apps/admin/" } },
    { "src": "/cliente/?$", "status": 308, "headers": { "Location": "/apps/client/" } },
    { "src": "/$", "status": 308, "headers": { "Location": "/apps/client/" } },

    { "src": "/apps/(.*)", "dest": "/apps/$1" },
    { "src": "/(.*)", "dest": "/apps/client/$1" }
  ]
}
